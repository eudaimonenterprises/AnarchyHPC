#!/usr/bin/python3
import json
import subprocess

images = []

# Query xCAT for all osimages and their rootimgdir
cmd = "lsdef -t osimage -i rootimgdir"
proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
output = proc.stdout.read().decode("utf-8")

current_image = None
current_path = None

for line in output.splitlines():
    line = line.strip()

    # Detect object name
    if line.startswith("Object name:"):
        if current_image and current_path:
            images.append((current_image, current_path))
        current_image = line.split(":", 1)[1].strip()
        current_path = None

    # Detect rootimgdir
    elif "rootimgdir=" in line:
        current_path = line.split("=", 1)[1].strip()

# Append last entry
if current_image and current_path:
    images.append((current_image, current_path))

# Build dynamic inventory
inventory = {
    "_meta": {
        "hostvars": {}
    },
    "osimages.xcat": {
        "hosts": []
    }
}

for image, path in images:
    host = f"{image}.osimages.xcat"
    inventory["_meta"]["hostvars"][host] = {
        "ansible_connection": "chroot",
        "ansible_host": path
    }
    inventory["osimages.xcat"]["hosts"].append(host)

print(json.dumps(inventory, indent=4, sort_keys=True))
