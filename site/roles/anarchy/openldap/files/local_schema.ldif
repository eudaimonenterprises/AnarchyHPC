dn: {{ openldap_suffix }}
dc: local
objectClass: domain

dn: ou=People,{{ openldap_suffix }}
ou: People
objectClass: top
objectClass: organizationalUnit

dn: ou=Group,{{ openldap_suffix }}
ou: Group
objectClass: top
objectClass: organizationalUnit

dn: cn=uid,{{ openldap_suffix }}
cn: uid
objectClass: uidNext
uidNumber: 1050

dn: cn=gid,{{ openldap_suffix }}
cn: gid
objectClass: uidNext
uidNumber: 1050

dn: ou=Policies,{{ openldap_suffix }}
ou: Policies
objectClass: organizationalUnit

dn: cn=pwdDefaultPolicy,ou=Policies,{{ openldap_suffix }}
objectClass: pwdPolicy
objectClass: person
objectClass: top
cn: pwdDefaultPolicy
sn: pwdDefaultPolicy
pwdAttribute: userPassword
pwdCheckQuality: 1
pwdMinAge: 0
pwdMaxAge: 0
pwdMinLength: 8
pwdInHistory: 2
pwdMaxFailure: 3
pwdFailureCountInterval: 0
pwdLockout: FALSE
pwdLockoutDuration: 0
pwdAllowUserChange: TRUE
pwdExpireWarning: 0
pwdGraceAuthNLimit: 0
pwdMustChange: FALSE
pwdSafeModify: FALSE

