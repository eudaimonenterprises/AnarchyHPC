# /etc/openldap/slapd.conf (generated by Ansible)

include {{ openldap_schema_path }}/core.schema
include {{ openldap_schema_path }}/cosine.schema
include {{ openldap_schema_path }}/inetorgperson.schema
include {{ openldap_schema_path }}/ppolicy.schema

modulepath {{ openldap_server_module_path }}
moduleload  back_{{ openldap_db_backend }}.la
moduleload  ppolicy.la
moduleload  memberof.la

# TLS settings
TLSCACertificateFile {{ openldap_tls_ca }}
TLSCertificateFile   {{ openldap_tls_crt }}
TLSCertificateKeyFile {{ openldap_tls_key }}

database    {{ openldap_db_backend }}
suffix      "{{ openldap_suffix }}"
rootdn      "{{ openldap_rootdn }}"
rootpw      {{ ldap_root_password_hash.stdout }}

directory   {{ openldap_server_dir_path }}
maxsize     1073741824

index default eq,sub
index cn,uid,givenName,sn eq,sub
index mail,objectClass eq

access to attrs=userPassword
  by self write
  by anonymous auth
  by dn.base="{{ openldap_rootdn }}" write
  by * none

access to *
  by self read
  by dn.base="{{ openldap_rootdn }}" write
  by * read

overlay ppolicy
ppolicy_default cn=Default,ou=Policies,{{ openldap_suffix }}
ppolicy_hash_cleartext on
ppolicy_use_lockout

overlay memberof
memberof-group-oc groupOfNames
memberof-member-ad member
memberof-refint true

