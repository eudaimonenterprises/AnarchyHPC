# /etc/openldap/slapd.conf (generated by Ansible)

include {{ openldap_schema_path }}/core.schema

modulepath {{ openldap_server_module_path }}
moduleload  back_{{ openldap_db_backend }}.la
moduleload  ppolicy.la
moduleload  memberof.la

# TLS settings
TLSCACertificateFile {{ openldap_tls_ca }}
TLSCertificateFile   {{ openldap_tls_crt }}
TLSCertificateKeyFile {{ openldap_tls_key }}

database    {{ openldap_db_backend }}
suffix      "dc=local"
rootdn      "cn=Manager,dc=local"
rootpw      {{ ldap_root_password_hash }}

directory   {{ openldap_server_dir_path }}

index default eq,sub
index cn,uid,givenName,sn eq,sub
index mail,objectClass eq

access to attrs=userPassword
  by self write
  by anonymous auth
  by dn.base="cn=Manager,dc=local" write
  by * none

access to *
  by self read
  by dn.base="cn=Manager,dc=local" write
  by * read

overlay ppolicy
ppolicy_default cn=Default,ou=Policies,dc=local
ppolicy_hash_cleartext on
ppolicy_use_lockout

overlay memberof
memberof_group_attr member
