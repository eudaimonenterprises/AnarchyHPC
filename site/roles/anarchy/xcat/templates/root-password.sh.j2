#!/bin/bash

# This script sets the root password inside the compute node image.
# It is intentionally a no-op unless a password is provided.

{% if root_password is defined and root_password | length > 0 %}
echo "root:{{ root_password }}" | chpasswd
{% elif root_password_hashed is defined and root_password_hashed | length > 0 %}
echo "root:{{ root_password_hashed }}" | chpasswd --encrypted
{% else %}
# No root password configured — do nothing
exit 0
{% endif %}

exit 0
