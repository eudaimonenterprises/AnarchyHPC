# xCAT API nginx reverse proxy
# Generated by Ansible

server {
    listen 7051;
    listen [::]:7051;

    # Allow large uploads if needed
    client_max_body_size 0;

    # Static files served by the API (optional)
    root /opt/xcat-api/static;

    # Authentication and API proxy
    location /api/ {
        proxy_pass http://127.0.0.1:7050/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional static file serving
    location /static/ {
        alias /opt/xcat-api/static/;
        expires max;
    }

    # Optional SSL
    {% if api_protocol == "https" %}
    ssl_certificate {{ ssl_certificate }};
    ssl_certificate_key {{ ssl_certificate_key }};
    ssl_verify_client off;
    {% endif %}
}
