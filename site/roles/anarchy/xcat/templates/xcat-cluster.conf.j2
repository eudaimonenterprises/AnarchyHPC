# xCAT Cluster Configuration
# Generated by Ansible

[CLUSTER]
NAME = {{ cluster_name }}
DOMAIN = {{ cluster_domain }}
SEARCH_DOMAINS = {{ cluster_search_domains | join(',') }}
DNS_FORWARDERS = {{ cluster_dns_forwarders | join(',') }}

[CONTROLLERS]
PRIMARY = {{ controller.hostname }}:{{ controller.ip }}
{% if controllers_ha is defined %}
{% for c in controllers_ha %}
CONTROLLER{{ loop.index }} = {{ c.hostname }}:{{ c.ip }}
{% endfor %}
{% endif %}

[NETWORKS]
# Provisioning network
PROVISIONING = {{ prov_network.name }}:{{ prov_network.ip }}/{{ prov_network.prefix }}:DHCP:{{ prov_network.start_ip }}-{{ prov_network.end_ip }}

{% if ipmi_network is defined %}
# IPMI network
IPMI = {{ ipmi_network.name }}:{{ ipmi_network.ip }}/{{ ipmi_network.prefix }}
{% endif %}

{% if ib_network is defined %}
# Infiniband network
INFINIBAND = {{ ib_network.name }}:{{ ib_network.ip }}/{{ ib_network.prefix }}
{% endif %}

[NODES]
RANGE = {{ node_range }}

[OSIMAGE]
NAME = {{ osimage_name }}
PATH = {{ osimage_path }}

[BMC]
USERNAME = {{ bmc_username }}
PASSWORD = {{ bmc_password }}

[HA]
ENABLED = {{ ha_enabled | default(false) }}
