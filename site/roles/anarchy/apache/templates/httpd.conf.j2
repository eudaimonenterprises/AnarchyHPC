# Standard Apache Configuration for AnarchyHPC
# Managed by Ansible - Changes will be overwritten

ServerRoot "{{ apache_server_root | default('/etc/httpd') }}"
Listen 80

# Load modules (Suse uses sysconfig, RedHat/Debian use Include)
{% if ansible_os_family == "RedHat" %}
Include conf.modules.d/*.conf
{% elif ansible_os_family == "Debian" %}
IncludeOptional mods-enabled/*.load
IncludeOptional mods-enabled/*.conf
{% endif %}

User {{ apache_user }}
Group {{ apache_group | default(apache_user) }}

ServerAdmin {{ admin_email | default('root@localhost') }}

<Directory />
    AllowOverride none
    Require all denied
</Directory>

DocumentRoot "{{ apache_doc_root | default('/var/www/html') }}"

<Directory "{{ apache_doc_root | default('/var/www/html') | dirname }}">
    AllowOverride None
    Require all granted
</Directory>

# Load modular configuration files
{% if ansible_os_family == "Suse" %}
IncludeOptional conf.d/*.conf
IncludeOptional vhosts.d/*.conf
{% else %}
IncludeOptional {{ apache_conf_dir }}/*.conf
{% endif %}

# Logging
ErrorLog "{{ apache_log_dir | default('logs') }}/error_log"
LogLevel warn

<IfModule log_config_module>
    LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
    CustomLog "{{ apache_log_dir | default('logs') }}/access_log" combined
</IfModule>
