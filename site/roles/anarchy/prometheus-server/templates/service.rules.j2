{{ ansible_managed | comment }}

groups:
- name: service_health
  rules:

  # -------------------------
  # Generic systemd failures
  # -------------------------
  - alert: ServiceFailed
    expr: node_systemd_unit_state{state="failed"} > 0
    for: 10m
    labels:
      severity: warning
      category: service
    annotations:
      description: '{% raw %}Service {{ $labels.name }} on {{ $labels.instance }} has failed{% endraw %}'


  # -------------------------
  # Controller services
  # -------------------------
  - alert: CriticalControllerServiceFailed
    expr: |
      node_systemd_unit_state{
        state="failed",
        name=~"(dhcpd|named|nginx|slurmctld|slurmdbd|munge|sssd|slapd|nfs-server).service"
      } > 0
    for: 10m
    labels:
      severity: critical
      category: controller
    annotations:
      description: '{% raw %}Critical controller service {{ $labels.name }} on {{ $labels.instance }} has failed{% endraw %}'


  # -------------------------
  # Compute node services
  # -------------------------
  - alert: ComputeNodeServiceFailed
    expr: |
      node_systemd_unit_state{
        state="failed",
        name=~"(slurmd|sshd|sssd|rsyslog|nfs-client).service"
      } > 0
    for: 10m
    labels:
      severity: danger
      category: compute
    annotations:
      description: '{% raw %}Compute node service {{ $labels.name }} on {{ $labels.instance }} has failed{% endraw %}'


  # -------------------------
  # Slurm-specific alerts
  # -------------------------
  - alert: SlurmctldDown
    expr: node_systemd_unit_state{name="slurmctld.service", state="failed"} > 0
    for: 5m
    labels:
      severity: critical
      category: slurm
    annotations:
      description: '{% raw %}slurmctld is down on {{ $labels.instance }}{% endraw %}'

  - alert: SlurmdDown
    expr: node_systemd_unit_state{name="slurmd.service", state="failed"} > 0
    for: 5m
    labels:
      severity: warning
      category: slurm
    annotations:
      description: '{% raw %}slurmd is down on {{ $labels.instance }}{% endraw %}'


  # -------------------------
  # Authentication services
  # -------------------------
  - alert: AuthenticationServiceFailed
    expr: node_systemd_unit_state{name=~"(sssd|slapd|munge).service", state="failed"} > 0
    for: 10m
    labels:
      severity: critical
      category: auth
    annotations:
      description: '{% raw %}Authentication service {{ $labels.name }} failed on {{ $labels.instance }}{% endraw %}'
