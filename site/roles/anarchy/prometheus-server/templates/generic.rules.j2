{{ ansible_managed | comment }}

groups:
- name: cluster
  rules:

  # -------------------------
  # Node health
  # -------------------------

  - alert: NodeDown
    expr: up{job="node_exporter"} == 0
    for: 5m
    labels:
      severity: critical
      category: node
    annotations:
      description: '{% raw %}Node {{ $labels.instance }} is unreachable{% endraw %}'

  - alert: HighCpuLoad
    expr: (node_load5{job="node_exporter"} / count(node_cpu_seconds_total{mode="idle", job="node_exporter"}) without (cpu,mode)) > 0.9
    for: 15m
    labels:
      severity: warning
      category: node
    annotations:
      description: '{% raw %}High CPU load on {{ $labels.instance }}{% endraw %}'

  - alert: HighMemoryUsage
    expr: (node_memory_MemAvailable_bytes{job="node_exporter"} / node_memory_MemTotal_bytes{job="node_exporter"}) < 0.1
    for: 15m
    labels:
      severity: warning
      category: node
    annotations:
      description: '{% raw %}Memory usage above 90% on {{ $labels.instance }}{% endraw %}'

  - alert: SwapUsageHigh
    expr: (node_memory_SwapFree_bytes{job="node_exporter"} / node_memory_SwapTotal_bytes{job="node_exporter"}) < 0.2
    for: 10m
    labels:
      severity: warning
      category: node
    annotations:
      description: '{% raw %}Swap usage above 80% on {{ $labels.instance }}{% endraw %}'


  # -------------------------
  # Filesystem
  # -------------------------

  - alert: FilesystemFull90
    expr: node_filesystem_avail_bytes{job="node_exporter", fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{job="node_exporter", fstype!~"tmpfs|overlay"} < 0.10
    for: 10m
    labels:
      severity: warning
      category: filesystem
    annotations:
      description: '{% raw %}Filesystem {{ $labels.mountpoint }} on {{ $labels.instance }} is above 90% usage{% endraw %}'

  - alert: FilesystemFull95
    expr: node_filesystem_avail_bytes{job="node_exporter", fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{job="node_exporter", fstype!~"tmpfs|overlay"} < 0.05
    for: 10m
    labels:
      severity: critical
      category: filesystem
    annotations:
      description: '{% raw %}Filesystem {{ $labels.mountpoint }} on {{ $labels.instance }} is above 95% usage{% endraw %}'


  # -------------------------
  # Hardware (IPMI)
  # -------------------------

  - alert: HighSystemTemperature
    expr: ipmi_temperature_celsius{name=~"System.*Temp"} > 70
    for: 10m
    labels:
      severity: warning
      category: hardware
    annotations:
      description: '{% raw %}System temperature above 70°C on {{ $labels.instance }}{% endraw %}'

  - alert: HighCpuTemperature
    expr: ipmi_temperature_celsius{name=~"CPU.*Temp"} > 90
    for: 10m
    labels:
      severity: critical
      category: hardware
    annotations:
      description: '{% raw %}CPU temperature above 90°C on {{ $labels.instance }}{% endraw %}'

  - alert: HardwareSensorFault
    expr: ipmi_sensor_state > 0
    labels:
      severity: warning
      category: hardware
    annotations:
      description: '{% raw %}Hardware sensor fault detected on {{ $labels.instance }} ({{ $labels.type }}){% endraw %}'


  # -------------------------
  # Networking
  # -------------------------

  - alert: ExcessiveTCPConnections
    expr: node_netstat_Tcp_CurrEstab{job="node_exporter"} > 2000
    labels:
      severity: warning
      category: network
    annotations:
      description: '{% raw %}More than 2000 established TCP connections on {{ $labels.instance }}{% endraw %}'


  # -------------------------
  # Time sync
  # -------------------------

  - alert: ClockSkew
    expr: (node_timex_offset_seconds > 1) or (node_timex_offset_seconds < -1)
    for: 5m
    labels:
      severity: warning
      category: time
    annotations:
      description: '{% raw %}Clock skew greater than 1 second on {{ $labels.instance }}{% endraw %}'


  # -------------------------
  # Slurm (optional)
  # -------------------------

  - alert: SlurmctldDown
    expr: slurm_up{component="slurmctld"} == 0
    for: 5m
    labels:
      severity: critical
      category: slurm
    annotations:
      description: '{% raw %}slurmctld is down{% endraw %}'

  - alert: SlurmdDown
    expr: slurm_up{component="slurmd"} == 0
    for: 5m
    labels:
      severity: warning
      category: slurm
    annotations:
      description: '{% raw %}slurmd down on {{ $labels.instance }}{% endraw %}'
