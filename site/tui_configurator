#!/bin/bash

set -euo pipefail

ALL_YML="group_vars/all.yml"
ALL_YML_EXAMPLE="group_vars/all.yml.example"
HOSTS_FILE="hosts"
HOSTS_EXAMPLE="hosts.example"

add_message() {
  echo -e "$1" | fold -w70 -s >> /tmp/mesg.$$.dat
}

show_message() {
  echo "+---------------------------------- X -------------------------------------+"
  echo "|                                                                          |"
  while read -r LINE; do
    printf '|  %-70s  |\n' "$LINE"
  done < /tmp/mesg.$$.dat
  echo "|                                                                          |"
  echo "+--------------------------------------------------------------------------+"
  truncate -s0 /tmp/mesg.$$.dat
}

cleanup() {
  rm -f /tmp/mesg.$$.dat 2>/dev/null || true
}
trap cleanup EXIT

# -----------------------------------------------------------------------------
# DEFAULT SOURCE SELECTION
# -----------------------------------------------------------------------------

if [[ -f "$ALL_YML" ]]; then
  DEFAULT_FILE="$ALL_YML"
else
  DEFAULT_FILE="$ALL_YML_EXAMPLE"
fi

if [[ -f "$HOSTS_FILE" ]]; then
  HOSTS_DEFAULT="$HOSTS_FILE"
else
  HOSTS_DEFAULT="$HOSTS_EXAMPLE"
fi

echo "Using defaults from ${DEFAULT_FILE} (YAML) and ${HOSTS_DEFAULT} (hosts)" > /dev/tty

# -----------------------------------------------------------------------------
# YAML READER
# -----------------------------------------------------------------------------

get_default() {
  local key="$1"
  local val

  local block
  block=$(awk -v k="^${key}:" '
    $0 ~ k {inblock=1; next}
    inblock && /^[[:space:]]*-/ {print; next}
    inblock {exit}
  ' "$DEFAULT_FILE")

  if [[ -z "$block" ]]; then
    val=$(awk -v k="^${key}:" '
      $0 ~ k {
        sub(/^[^:]+:[[:space:]]*/, "", $0)
        print
        exit
      }
    ' "$DEFAULT_FILE")

    val="${val//\"/}"
    val="${val//\'/}"
    echo "$val"
    return
  fi

  echo "$block" \
    | sed -n 's/^[[:space:]]*-[[:space:]]*//p' \
    | sed 's/"//g; s/'"'"'//g' \
    | paste -sd "," -
}

get_default_ssh_key_from_hosts() {
  local val
  val=$(grep -Eo 'ansible_ssh_private_key_file=[^ ]+' "$HOSTS_DEFAULT" \
        | head -n1 \
        | cut -d= -f2-)
  val="${val//\"/}"
  val="${val//\'/}"
  echo "$val"
}

get_default_ssh_user_from_hosts() {
  local val
  val=$(grep -Eo 'ansible_user=[^ ]+' "$HOSTS_DEFAULT" \
        | head -n1 \
        | cut -d= -f2-)
  val="${val//\"/}"
  val="${val//\'/}"
  echo "$val"
}

# -----------------------------------------------------------------------------
# PROMPT HELPERS
# -----------------------------------------------------------------------------

prompt_default() {
  local prompt="$1"
  local default="$2"
  local var
  read -r -p "${prompt} [${default}]: " var < /dev/tty
  echo "${var:-$default}"
}

prompt_bool() {
  local prompt="$1"
  local default="$2"
  local def_char
  if [[ "$default" = "true" ]]; then
    def_char="Y/n"
  else
    def_char="y/N"
  fi
  while true; do
    read -r -p "${prompt} (${def_char}): " ans < /dev/tty
    case "$ans" in
      "") echo "$default"; return ;;
      y|Y|yes|YES) echo "true"; return ;;
      n|N|no|NO) echo "false"; return ;;
      *) echo "Please answer y or n." > /dev/tty ;;
    esac
  done
}

# -----------------------------------------------------------------------------
# GATHER VALUES
# -----------------------------------------------------------------------------

add_message "Welcome to the AnarchyHPC configuration TUI."
add_message "Defaults come from ${DEFAULT_FILE}."
show_message

echo "Gathering cluster basics" > /dev/tty
anarchy_domain=$(prompt_default "Cluster internal domain name" "$(get_default anarchy_domain)")
project_id=$(prompt_default "Project ID" "$(get_default project_id)")

echo "Gathering controller settings" > /dev/tty
anarchy_ctrl1_hostname=$(prompt_default "Controller hostname" "$(get_default anarchy_ctrl1_hostname)")
anarchy_ctrl1_ip=$(prompt_default "Controller IP address" "$(get_default anarchy_ctrl1_ip)")

echo "Gathering HA and external FQDN" > /dev/tty
ha=$(prompt_bool "Enable High Availability (HA)" "$(get_default ha)")
anarchy_external_fqdn=$(prompt_default "External FQDN" "$(get_default anarchy_external_fqdn)")

# Fallback if user leaves it blank
if [[ -z "$anarchy_external_fqdn" ]]; then
  anarchy_external_fqdn="${anarchy_ctrl1_hostname}.${anarchy_domain}"
fi

echo "Gathering DNS forwarders" > /dev/tty
default_dns=$(get_default anarchy_dns_forwarders)
IFS=',' read -r -a dns_array <<< "$(prompt_default "DNS forwarders (comma-separated)" "$default_dns")"

echo "Gathering feature toggles" > /dev/tty
enable_selinux=$(prompt_bool "Enable SELinux" "$(get_default enable_selinux)")
enable_ood=$(prompt_bool "Enable Open OnDemand" "$(get_default enable_ood)")
enable_openhpc=$(prompt_bool "Enable OpenHPC" "$(get_default enable_openhpc)")
enable_easybuild=$(prompt_bool "Enable EasyBuild" "$(get_default enable_easybuild)")
enable_authentication=$(prompt_bool "Enable internal authentication" "$(get_default enable_authentication)")

echo "Gathering workload manager" > /dev/tty
wm=$(prompt_default "Workload manager (slurm or k3s)" "$(get_default workload_manager)")
case "$wm" in
  k3s|K3S) wm="k3s" ;;
  *)       wm="slurm" ;;
esac

echo "Gathering cluster network settings" > /dev/tty
anarchy_cluster_net=$(prompt_default "Cluster network" "$(get_default anarchy_cluster_net)")
anarchy_cluster_netprefix=$(prompt_default "Cluster network prefix" "$(get_default anarchy_cluster_netprefix)")
anarchy_cluster_dhcp_start=$(prompt_default "DHCP range start" "$(get_default anarchy_cluster_dhcp_start)")
anarchy_cluster_dhcp_end=$(prompt_default "DHCP range end" "$(get_default anarchy_cluster_dhcp_end)")

echo "Gathering BMC network settings" > /dev/tty
anarchy_bmc_net=$(prompt_default "BMC network" "$(get_default anarchy_bmc_net)")
anarchy_bmc_netprefix=$(prompt_default "BMC network prefix" "$(get_default anarchy_bmc_netprefix)")

# -----------------------------------------------------------------------------
# SSH SETUP
# -----------------------------------------------------------------------------

echo
echo "=== AnarchyHPC SSH Setup ==="

echo
echo "Which LOCAL user should own the SSH key?"
read -r -p "Local username [$(logname)]: " LOCAL_USER
LOCAL_USER=${LOCAL_USER:-$(logname)}

LOCAL_HOME=$(eval echo "~${LOCAL_USER}")
if [[ ! -d "$LOCAL_HOME" ]]; then
  echo "ERROR: Local user '$LOCAL_USER' does not exist or has no home directory." >&2
  exit 1
fi

DEFAULT_KEY_PATH="${LOCAL_HOME}/.ssh/anarchy_id_ed25519"

echo
echo "Controller hostname or IP: ${anarchy_ctrl1_ip}"
CONTROLLER_HOST="${anarchy_ctrl1_ip}"

DEFAULT_REMOTE_USER="$(get_default_ssh_user_from_hosts)"

read -r -p "SSH username for controller [${DEFAULT_REMOTE_USER}]: " CONTROLLER_USER
CONTROLLER_USER="${CONTROLLER_USER:-$DEFAULT_REMOTE_USER}"

echo
echo "Do you already have SSH key-based access to the controller?"
read -r -p "[y/N]: " HAVE_KEY
HAVE_KEY=${HAVE_KEY:-n}

SSH_KEY_PATH=""

if [[ "$HAVE_KEY" =~ ^[Yy]$ ]]; then
  DEFAULT_EXISTING_KEY="$(get_default_ssh_key_from_hosts)"

  echo
  read -r -p "Path to your existing LOCAL SSH private key [${DEFAULT_EXISTING_KEY}]: " SSH_KEY_PATH
  SSH_KEY_PATH="${SSH_KEY_PATH:-$DEFAULT_EXISTING_KEY}"
  SSH_KEY_PATH=${SSH_KEY_PATH/#\~/$LOCAL_HOME}

  if [[ ! -f "$SSH_KEY_PATH" ]]; then
    echo "ERROR: Key '$SSH_KEY_PATH' not found." >&2
    exit 1
  fi

  chmod 600 "$SSH_KEY_PATH" || true

  echo
  echo "Testing SSH access..."
  if ! ssh -i "$SSH_KEY_PATH" -o BatchMode=yes -o ConnectTimeout=10 \
      "${CONTROLLER_USER}@${CONTROLLER_HOST}" true 2>/dev/null; then
    echo "ERROR: Unable to authenticate with the provided key." >&2
    exit 1
  fi

else
  echo
  echo "Where should the new LOCAL SSH key be stored?"
  echo "1) Default: ${DEFAULT_KEY_PATH}"
  echo "2) Custom path"
  read -r -p "Choose [1/2]: " KEY_CHOICE

  case "$KEY_CHOICE" in
    1|"") SSH_KEY_PATH="$DEFAULT_KEY_PATH" ;;
    2)
      read -r -p "Enter full path for new LOCAL SSH private key: " SSH_KEY_PATH
      SSH_KEY_PATH=${SSH_KEY_PATH/#\~/$LOCAL_HOME}
      ;;
    *)
      echo "Invalid choice." >&2
      exit 1
      ;;
  esac

  SSH_PUB_PATH="${SSH_KEY_PATH}.pub"
  SSH_DIR=$(dirname "$SSH_KEY_PATH")

  mkdir -p "$SSH_DIR"
  chmod 700 "$SSH_DIR"
  chown "$LOCAL_USER":"$LOCAL_USER" "$SSH_DIR"

  if [[ -f "$SSH_KEY_PATH" ]]; then
    echo
    read -r -p "Key already exists at '$SSH_KEY_PATH'. Reuse it? [Y/n]: " REUSE
    REUSE=${REUSE:-y}
    if [[ ! "$REUSE" =~ ^[Yy]$ ]]; then
      echo "Aborting to avoid overwriting existing key." >&2
      exit 1
    fi
  else
    echo
    echo "Generating SSH key at '$SSH_KEY_PATH'..."
    ssh-keygen -t ed25519 -f "$SSH_KEY_PATH" -N "" -C "anarchyhpc@${HOSTNAME}"

    chown "$LOCAL_USER":"$LOCAL_USER" "$SSH_KEY_PATH" "$SSH_PUB_PATH"
    chmod 600 "$SSH_KEY_PATH"
    chmod 644 "$SSH_PUB_PATH"
  fi

  echo
  echo "Installing public key on controller (you will be prompted for password)..."

  SSH_PUB_PATH="${SSH_KEY_PATH}.pub"
  if command -v ssh-copy-id >/dev/null 2>&1; then
    ssh-copy-id -i "$SSH_PUB_PATH" "${CONTROLLER_USER}@${CONTROLLER_HOST}"
  else
    scp "$SSH_PUB_PATH" "${CONTROLLER_USER}@${CONTROLLER_HOST}:/tmp/anarchyhpc_key.pub"
    ssh "${CONTROLLER_USER}@${CONTROLLER_HOST}" \
      "mkdir -p ~/.ssh && cat /tmp/anarchyhpc_key.pub >> ~/.ssh/authorized_keys && rm -f /tmp/anarchyhpc_key.pub && chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys"
  fi

  echo
  echo "Testing SSH access with new key..."
  if ! ssh -i "$SSH_KEY_PATH" -o BatchMode=yes -o ConnectTimeout=10 \
      "${CONTROLLER_USER}@${CONTROLLER_HOST}" true 2>/dev/null; then
    echo "ERROR: Key-based SSH login failed." >&2
    exit 1
  fi
fi

REMOTE_OS=$(ssh -i "$SSH_KEY_PATH" -o BatchMode=yes \
    "${CONTROLLER_USER}@${CONTROLLER_HOST}" \
    "awk -F= '/^ID=/{print \$2}' /etc/os-release | tr -d '\"'")

REMOTE_OS_FAMILY=$(echo "$REMOTE_OS" | tr '[:upper:]' '[:lower:]')

case "$REMOTE_OS_FAMILY" in
    rhel|centos|rocky|almalinux) REMOTE_OS_FAMILY="redhat" ;;
    opensuse*|suse*)             REMOTE_OS_FAMILY="opensuse" ;;
    ubuntu)                      REMOTE_OS_FAMILY="ubuntu" ;;
esac

echo
echo "Checking for SFTP/SCP support on controller..."

# -----------------------------------------------------------------------------
# FIX SUPPORT ON REMOTE CONTROLLER (ALL DISTROS)
# -----------------------------------------------------------------------------

read -r -p "Enable controller operating system bug fixes? [y/N] " answer
if [[ "$answer" =~ ^[Yy]$ ]]; then
    SFTP_ENABLED="no"
else
    SFTP_ENABLED="yes"
fi

if [[ "$SFTP_ENABLED" == "no" ]]; then

    case "$REMOTE_OS_FAMILY" in

        redhat)
            # Correct SFTP subsystem
            #ssh -t -i "$SSH_KEY_PATH" \
            #    -o PreferredAuthentications=keyboard-interactive,password \
            #    -o PubkeyAuthentication=yes \
            #    "${CONTROLLER_USER}@${CONTROLLER_HOST}" \
            #    "sudo sed -i 's|Subsystem[[:space:]]\+sftp.*|Subsystem sftp /usr/libexec/openssh/sftp-server|' /etc/ssh/sshd_config &&
            #    sudo systemctl restart sshd"
            ;;

        opensuse)
            # Fix incorrect SFTP subsystem in SUSE's main sshd_config
            echo "Fixing SFTP/SCP support on controller..."
            ssh -t -i "$SSH_KEY_PATH" \
                -o PreferredAuthentications=keyboard-interactive,password \
                -o PubkeyAuthentication=yes \
                "${CONTROLLER_USER}@${CONTROLLER_HOST}" \
                "sudo sed -i 's|/usr/libexec/openssh/sftp-server|/usr/libexec/ssh/sftp-server|' /etc/ssh/sshd_config &&
                sudo systemctl restart sshd"

            ###############################################################################
            # OpenLDAP Automated Bootstrap Script
            #
            # This script connects to the target controller host over SSH and performs a
            # complete, automated OpenLDAP bootstrap, including:
            #
            #   • Installing required OpenLDAP client utilities (slappasswd)
            #   • Prompting the user for the LDAP admin password and hashing it securely
            #   • Generating an initial LDIF containing the base DN and Manager entry
            #   • Preparing slapd.conf and converting it into a slapd.d configuration
            #   • Importing the initial database as the ldap user
            #   • Correcting all ownership and permissions for slapd.d and the DB directory
            #   • Cleaning up temporary files
            #   • (Optionally) removing a stale ldapi socket if present
            #       - This prevents slapd from failing with “address already in use”
            #       - Only the socket is removed; the directory is preserved
            #   • Installing a systemd service file with a hard‑coded ExecStart
            #   • Updating /etc/sysconfig/openldap (removing SLAPD_OPTIONS)
            #   • Reloading systemd and starting the slapd service
            #
            # The script is designed to be idempotent and safe to re-run. It ensures that
            # slapd starts cleanly even after crashes, reboots, or partial configuration.
            ###############################################################################


            read -p "Run full OpenLDAP bootstrap on ${CONTROLLER_HOST}? [y/N]: " RUN_BOOTSTRAP
            RUN_BOOTSTRAP=${RUN_BOOTSTRAP:-N}
            if [[ "$RUN_BOOTSTRAP" =~ ^[Yy]$ ]]; then

              echo "Starting OpenLDAP bootstrap on ${CONTROLLER_HOST}..."

              ssh -tt -i "$SSH_KEY_PATH" \
                  -o PreferredAuthentications=keyboard-interactive,password \
                  -o PubkeyAuthentication=yes \
                  "${CONTROLLER_USER}@${CONTROLLER_HOST}" '
              set +o history
              umask 077

              # 0. Ensure slappasswd exists
              if ! rpm -q openldap2_6-client >/dev/null 2>&1; then
                  echo "Installing openldap2_6-client..."
                  sudo zypper --non-interactive install openldap2_6-client
              else
                  echo "openldap2_6-client already installed."
              fi

              # 1. Let slappasswd handle password prompting + confirmation
              echo "Please enter the LDAP admin password."
              HASHED_PASS=$(/usr/sbin/slappasswd)

              # 2. Build LDIF
              LDIF_CONTENT=$(cat <<EOF
              dn: dc=my-domain,dc=com
              objectClass: top
              objectClass: dcObject
              objectClass: organization
              o: My Organization
              dc: my-domain

              dn: cn=Manager,dc=my-domain,dc=com
              objectClass: simpleSecurityObject
              objectClass: organizationalRole
              cn: Manager
              description: LDAP Administrator
              userPassword: $HASHED_PASS
EOF
              )

              unset HASHED_PASS

              # 3. Write LDIF securely for ldap user
              echo "$LDIF_CONTENT" | sudo tee /tmp/init.ldif >/dev/null
              sudo chmod 600 /tmp/init.ldif
              sudo chown ldap:ldap /tmp/init.ldif

              # 4. Prepare slapd.conf → slapd.d
              sudo sed -i "s|^#modulepath /usr/lib64/openldap|modulepath /usr/lib64/openldap|" /etc/openldap/slapd.conf
              sudo sed -i "s|^#moduleload back_mdb.la|moduleload back_mdb.la|" /etc/openldap/slapd.conf
              sudo sed -i "/^[[:space:]]*directory[[:space:]]\\+\\/var\\/lib\\/ldap/a maxsize      1073741824" /etc/openldap/slapd.conf

              sudo chmod 770 /var/lib/ldap

              # 4.1 Stop slapd cleanly before modifying DB/config
              sudo systemctl stop slapd || true
              sleep 1

              # 4.2 Regenerate slapd.d from slapd.conf
              sudo slaptest -f /etc/openldap/slapd.conf -F /etc/openldap/slapd.d

              # 5. Temporarily give ldap access to slapd.d for slapadd
              sudo chown -R ldap:ldap /etc/openldap/slapd.d

              # 6. Ensure DB directory is writable by ldap BEFORE slapadd
              sudo chown -R ldap:ldap /var/lib/ldap
              sudo chmod 750 /var/lib/ldap

              # 7. Import the database as ldap
              sudo -u ldap slapadd -n 1 -F /etc/openldap/slapd.d -l /tmp/init.ldif

              # 8. Restore slapd.d ownership AND correct permissions
              sudo chown -R root:root /etc/openldap/slapd.d
              sudo chmod 700 /etc/openldap/slapd.d
              sudo chmod 700 /etc/openldap/slapd.d/cn=config
              sudo chmod 600 /etc/openldap/slapd.d/cn=config.ldif

              # 9. Fix DB permissions (runtime)
              sudo chown -R ldap:ldap /var/lib/ldap
              sudo chmod 750 /var/lib/ldap

              # 10. Cleanup LDIF
              sudo rm -f /tmp/init.ldif

              # >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
              # INSERTED BLOCK — CLEANUP STALE ldapi SOCKET (CORRECT VERSION)
              # >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

              # Delete ONLY the stale ldapi socket if it exists
              if [ -S /run/slapd/ldapi ]; then
                  sudo rm -f /run/slapd/ldapi
              fi

              # Ensure the directory exists (because /run is tmpfs)
              if [ ! -d /run/slapd ]; then
                  sudo mkdir -p /run/slapd
                  sudo chown ldap:ldap /run/slapd
              fi

              # <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

              # 11. Write a sysconfig-aware slapd.service with hard-coded ExecStart
              sudo tee /usr/lib/systemd/system/slapd.service >/dev/null <<EOF
              [Unit]
              Description=OpenLDAP Server Daemon
              After=syslog.target network.target

              [Service]
              Type=forking
              EnvironmentFile=-/etc/sysconfig/openldap
              ExecStart=/usr/sbin/slapd -h "ldap:/// ldapi:///" -F /etc/openldap/slapd.d

              [Install]
              WantedBy=multi-user.target
EOF

              # 12. Ensure sysconfig contains correct values (SLAPD_OPTIONS REMOVED)
              grep -q "^SLAPD_URLS=" /etc/sysconfig/openldap \
                  && sudo sed -i "s|^SLAPD_URLS=.*|SLAPD_URLS=\"ldap:/// ldapi:///\"|" /etc/sysconfig/openldap \
                  || echo "SLAPD_URLS=\"ldap:/// ldapi:///\"" | sudo tee -a /etc/sysconfig/openldap >/dev/null

              grep -q "^SLAPD_CONFIG_BACKEND=" /etc/sysconfig/openldap \
                  && sudo sed -i "s|^SLAPD_CONFIG_BACKEND=.*|SLAPD_CONFIG_BACKEND=\"config\"|" /etc/sysconfig/openldap \
                  || echo "SLAPD_CONFIG_BACKEND=\"config\"" | sudo tee -a /etc/sysconfig/openldap >/dev/null

              grep -q "^SLAPD_CONF=" /etc/sysconfig/openldap \
                  && sudo sed -i "s|^SLAPD_CONF=.*|SLAPD_CONF=\"/etc/openldap/slapd.d\"|" /etc/sysconfig/openldap \
                  || echo "SLAPD_CONF=\"/etc/openldap/slapd.d\"" | sudo tee -a /etc/sysconfig/openldap >/dev/null

              # REMOVE SLAPD_OPTIONS ENTIRELY
              sudo sed -i "/^SLAPD_OPTIONS=/d" /etc/sysconfig/openldap

              # 13. Reload systemd and start slapd
              sudo systemctl daemon-reload
              sudo systemctl restart slapd
              '
            else
              echo "OpenLDAP bootstrap skipped."
            fi

            # ======================================================================
            # Create systemd override for slapd (persistent, SUSE-safe)
            # This ensures slapd always starts with your custom ExecStart, without
            # overwriting vendor files in /usr/lib/systemd/system.
            # ======================================================================

            read -p "Create systemd override for slapd? [y/N]: " RUN_OVERRIDE
            RUN_OVERRIDE=${RUN_OVERRIDE:-N}

            if [[ "$RUN_OVERRIDE" =~ ^[Yy]$ ]]; then
                echo "Creating systemd override on ${CONTROLLER_HOST}..."

                ssh -tt -i "$SSH_KEY_PATH" \
                    -o PreferredAuthentications=keyboard-interactive,password \
                    -o PubkeyAuthentication=yes \
                    "${CONTROLLER_USER}@${CONTROLLER_HOST}" '
                    sudo mkdir -p /etc/systemd/system/slapd.service.d

                    sudo tee /etc/systemd/system/slapd.service.d/override.conf >/dev/null <<'"EOF"'
            [Service]
            Type=forking
            EnvironmentFile=-/etc/sysconfig/openldap

            ExecStart=
            ExecStart=/usr/sbin/slapd -h "ldap:/// ldapi:///" -F /etc/openldap/slapd.d
EOF

                    sudo systemctl daemon-reload
                    sudo systemctl restart slapd
                    echo "Override created and slapd restarted."
                    '
            else
                echo "Systemd override skipped."
            fi
            ;;

        debian)
            # Correct SFTP subsystem
            #ssh -t -i "$SSH_KEY_PATH" \
            #    -o PreferredAuthentications=keyboard-interactive,password \
            #    -o PubkeyAuthentication=yes \
            #    "${CONTROLLER_USER}@${CONTROLLER_HOST}" \
            #    "sudo sed -i 's|Subsystem[[:space:]]\+sftp.*|Subsystem sftp /usr/lib/openssh/sftp-server|' /etc/ssh/sshd_config &&
            #    sudo systemctl restart sshd"
            ;;

        *)
            echo "WARNING: Unknown OS family '$REMOTE_OS_FAMILY'. Skipping controller operating system bug fixes."
            ;;
    esac
fi

echo
echo "=== SSH setup complete ==="

# -----------------------------------------------------------------------------
# WRITE all.yml BY COPYING EXAMPLE AND PATCHING VALUES
# -----------------------------------------------------------------------------

echo "Writing configuration to ${ALL_YML}" > /dev/tty

cp "$ALL_YML_EXAMPLE" "$ALL_YML"

set_yaml() {
  local key="$1"
  local value="$2"
  value=$(printf '%s\n' "$value" | sed 's/[\/&]/\\&/g')
  sed -i "s|^${key}:.*|${key}: ${value}|" "$ALL_YML"
}

set_yaml "anarchy_domain" "\"$anarchy_domain\""
set_yaml "project_id" "\"$project_id\""
set_yaml "anarchy_ctrl1_hostname" "\"$anarchy_ctrl1_hostname\""
set_yaml "anarchy_ctrl1_ip" "\"$anarchy_ctrl1_ip\""
set_yaml "ha" "$ha"
set_yaml "anarchy_external_fqdn" "\"$anarchy_external_fqdn\""
set_yaml "enable_selinux" "$enable_selinux"
set_yaml "enable_ood" "$enable_ood"
set_yaml "enable_openhpc" "$enable_openhpc"
set_yaml "enable_easybuild" "$enable_easybuild"
set_yaml "enable_authentication" "$enable_authentication"

set_yaml "anarchy_cluster_net" "\"$anarchy_cluster_net\""
set_yaml "anarchy_cluster_netprefix" "\"$anarchy_cluster_netprefix\""
set_yaml "anarchy_cluster_dhcp_start" "\"$anarchy_cluster_dhcp_start\""
set_yaml "anarchy_cluster_dhcp_end" "\"$anarchy_cluster_dhcp_end\""

set_yaml "anarchy_bmc_net" "\"$anarchy_bmc_net\""
set_yaml "anarchy_bmc_netprefix" "\"$anarchy_bmc_netprefix\""

# Replace DNS block safely
sed -i "/^anarchy_dns_forwarders:/,/^[^[:space:]]/c\
anarchy_dns_forwarders:" "$ALL_YML"
for dns in "${dns_array[@]}"; do
  echo "  - \"$dns\"" >> "$ALL_YML"
done

# Replace workload manager block
sed -i "/^workload_manager:/,/^[^[:space:]]/c\
workload_manager:\n  - \"$wm\"" "$ALL_YML"

# -----------------------------------------------------------------------------
# WRITE hosts FILE
# -----------------------------------------------------------------------------

echo "Writing inventory to ${HOSTS_FILE}" > /dev/tty

{
  echo "[controllers]"
  echo "${anarchy_ctrl1_hostname} ansible_host=${anarchy_ctrl1_ip} ansible_user=${CONTROLLER_USER} ansible_ssh_private_key_file=${SSH_KEY_PATH} ansible_become=true"
} > "$HOSTS_FILE"

# -----------------------------------------------------------------------------
# FINAL MESSAGES
# -----------------------------------------------------------------------------

echo "Configuration flow completed successfully" > /dev/tty
add_message "Configuration complete."
add_message "Updated:"
add_message "  - ${ALL_YML}"
add_message "  - ${HOSTS_FILE}"
show_message

echo "$REMOTE_OS_FAMILY" >&3

exit 0
