#!/bin/bash

set -euo pipefail

ALL_YML="group_vars/all.yml"
ALL_YML_EXAMPLE="group_vars/all.yml.example"
HOSTS_FILE="hosts"
HOSTS_EXAMPLE="hosts.example"

add_message() {
  echo -e "$1" | fold -w70 -s >> /tmp/mesg.$$.dat
}

show_message() {
  echo "+---------------------------------- X -------------------------------------+"
  echo "|                                                                          |"
  while read -r LINE; do
    printf '|  %-70s  |\n' "$LINE"
  done < /tmp/mesg.$$.dat
  echo "|                                                                          |"
  echo "+--------------------------------------------------------------------------+"
  truncate -s0 /tmp/mesg.$$.dat
}

cleanup() {
  rm -f /tmp/mesg.$$.dat 2>/dev/null || true
}
trap cleanup EXIT

# ---------------------------------------------------------------------------
# Ensure base files exist
# ---------------------------------------------------------------------------

echo "Checking base files (${ALL_YML}, ${HOSTS_FILE})" > /dev/tty

if [ ! -f "$ALL_YML" ]; then
  cp "$ALL_YML_EXAMPLE" "$ALL_YML"
fi

if [ ! -f "$HOSTS_FILE" ]; then
  cp "$HOSTS_EXAMPLE" "$HOSTS_FILE"
fi

# ---------------------------------------------------------------------------
# YAML helpers
# ---------------------------------------------------------------------------

get_yaml_value() {
  local key="$1"
  local default="$2"
  local val
  val=$(grep -E "^${key}:" "$ALL_YML" | head -n1 | sed -E "s/^${key}:[[:space:]]*//")
  if [ -z "$val" ]; then
    echo "$default"
  else
    echo "$val" | sed -E "s/^'(.*)'$/\1/; s/^\"(.*)\"$/\1/"
  fi
}

set_yaml_value() {
  local key="$1"
  local value="$2"
  local file="$ALL_YML"

  # YAML-safe quoting
  case "$value" in
    true|false) new="${key}: ${value}" ;;
    *) new="${key}: \"${value}\"" ;;
  esac

  # Replace existing key (with or without indentation)
  if grep -qE "^[[:space:]]*${key}:" "$file"; then
    sed -i -E "s|^[[:space:]]*${key}:.*|${new}|" "$file"
    return
  fi

  # Insert before marker (match even if indented or with extra text)
  if grep -q "DO NOT REMOVE" "$file"; then
    sed -i "/DO NOT REMOVE/i ${new}" "$file"
  else
    # Fallback: append at end
    echo "$new" >> "$file"
  fi
}

set_yaml_list_strings() {
  local key="$1"
  shift
  local items=("$@")

  awk -v k="${key}:" '
    $0 ~ "^"k {skip=1; next}
    skip && /^[[:space:]]*-/ {next}
    skip && NF==0 {skip=0; next}
    !skip {print}
  ' "$ALL_YML" > "$ALL_YML.tmp"

  mv "$ALL_YML.tmp" "$ALL_YML"

  {
    echo "${key}:"
    for i in "${items[@]}"; do
      echo "  - \"${i}\""
    done
  } >> "$ALL_YML"
}

remove_yaml_block() {
  local key="$1"
  awk -v k="${key}:" '
    # When we see the key, start skipping
    $0 ~ "^"k {
      skip=1
      next
    }

    # If skipping, skip lines that are indented (part of the block)
    skip && /^[[:space:]]+/ {
      next
    }

    # If skipping and we hit a non-indented line, stop skipping
    skip {
      skip=0
    }

    # Print everything else
    { print }
  ' "$ALL_YML" > "$ALL_YML.tmp"
  mv "$ALL_YML.tmp" "$ALL_YML"
}

# ---------------------------------------------------------------------------
# Prompt helpers
# ---------------------------------------------------------------------------

prompt_default() {
  local prompt="$1"
  local default="$2"
  local var
  read -r -p "${prompt} [${default}]: " var < /dev/tty
  echo "${var:-$default}"
}

prompt_bool() {
  local prompt="$1"
  local default="$2"
  local def_char
  if [ "$default" = "true" ]; then
    def_char="Y/n"
  else
    def_char="y/N"
  fi
  while true; do
    read -r -p "${prompt} (${def_char}): " ans < /dev/tty
    case "$ans" in
      "") echo "$default"; return ;;
      y|Y|yes|YES) echo "true"; return ;;
      n|N|no|NO) echo "false"; return ;;
      *) echo "Please answer y or n." > /dev/tty ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Gather values
# ---------------------------------------------------------------------------

add_message "Welcome to the AnarchyHPC configuration TUI."
add_message "You will be asked a few questions; defaults are shown in brackets."
show_message

echo "Gathering cluster basics" > /dev/tty
anarchy_domain=$(prompt_default "Cluster internal domain name" "$(get_yaml_value anarchy_domain cluster.local)")
project_id=$(prompt_default "Project ID" "$(get_yaml_value project_id 000000)")

echo "Gathering controller settings" > /dev/tty
anarchy_ctrl1_hostname=$(prompt_default "Controller hostname" "$(get_yaml_value anarchy_ctrl1_hostname controller1)")
anarchy_ctrl1_ip=$(prompt_default "Controller IP address" "$(get_yaml_value anarchy_ctrl1_ip 10.0.0.11)")

echo "Gathering HA and external FQDN" > /dev/tty
ha=$(prompt_bool "Enable High Availability (HA)" "$(get_yaml_value ha false)")
anarchy_external_fqdn=$(prompt_default "External FQDN" "$(get_yaml_value anarchy_external_fqdn "")")

echo "Gathering DNS forwarders" > /dev/tty
cur_dns1=$(grep -A5 anarchy_dns_forwarders "$ALL_YML" | grep -E '^\s*-\s*"' | sed -n '1p' | sed -E 's/.*"(.*)".*/\1/')
cur_dns2=$(grep -A5 anarchy_dns_forwarders "$ALL_YML" | grep -E '^\s*-\s*"' | sed -n '2p' | sed -E 's/.*"(.*)".*/\1/')
default_dns="${cur_dns1:-1.1.1.1},${cur_dns2:-1.0.0.1}"
dns_input=$(prompt_default "DNS forwarders" "$default_dns")
IFS=',' read -r -a dns_array <<< "$dns_input"

echo "Gathering feature toggles" > /dev/tty
enable_selinux=$(prompt_bool "Enable SELinux" "$(get_yaml_value enable_selinux true)")
enable_ood=$(prompt_bool "Enable Open OnDemand" "$(get_yaml_value enable_ood true)")
enable_openhpc=$(prompt_bool "Enable OpenHPC" "$(get_yaml_value enable_openhpc true)")
enable_easybuild=$(prompt_bool "Enable EasyBuild" "$(get_yaml_value enable_easybuild false)")
enable_authentication=$(prompt_bool "Enable internal authentication" "$(get_yaml_value enable_authentication true)")

echo "Gathering workload manager" > /dev/tty
cur_wm=$(grep -A5 workload_manager "$ALL_YML" | grep -E "^\s*-\s*'" | head -n1 | sed -E "s/.*'(.*)'.*/\1/")
wm=$(prompt_default "Workload manager (slurm or k3s)" "${cur_wm:-slurm}")
[[ "$wm" != "k3s" ]] && wm="slurm"

# ---------------------------------------------------------------------------
# Write back
# ---------------------------------------------------------------------------

echo "Writing configuration to ${ALL_YML}" > /dev/tty

set_yaml_value "anarchy_domain" "$anarchy_domain"
set_yaml_value "project_id" "$project_id"
set_yaml_value "anarchy_ctrl1_hostname" "$anarchy_ctrl1_hostname"
set_yaml_value "anarchy_ctrl1_ip" "$anarchy_ctrl1_ip"
set_yaml_value "ha" "$ha"
set_yaml_value "anarchy_external_fqdn" "$anarchy_external_fqdn"
set_yaml_value "enable_selinux" "$enable_selinux"
set_yaml_value "enable_ood" "$enable_ood"
set_yaml_value "enable_openhpc" "$enable_openhpc"
set_yaml_value "enable_easybuild" "$enable_easybuild"
set_yaml_value "enable_authentication" "$enable_authentication"

remove_yaml_block "workload_manager"
{
  echo "workload_manager:"
  echo "  - '${wm}'"
} >> "$ALL_YML"

# Fix DNS block
set_yaml_list_strings "anarchy_dns_forwarders" "${dns_array[@]}"


# ---------------------------------------------------------------------------
# NOTE:
# Ansible does NOT read controller IPs from group_vars/all.yml.
# It uses the inventory file (hosts). The first time this TUI runs,
# hosts is copied from hosts.example and never updated again.
# This block regenerates the inventory so Ansible connects to the
# correct controller hostname and IP selected in the TUI.
# ---------------------------------------------------------------------------
echo "Writing inventory to ${HOSTS_FILE}" > /dev/tty
{
  echo "[controllers]"
  echo "${anarchy_ctrl1_hostname} ansible_host=${anarchy_ctrl1_ip}"
} > "$HOSTS_FILE"


echo "Configuration flow completed successfully" > /dev/tty
add_message "Configuration complete."
add_message "Updated:"
add_message "  - ${ALL_YML}"
show_message

exit 0
